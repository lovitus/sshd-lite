+package terminal
+
+import "golang.org/x/sys/windows"
+
+// Resolve before starting a child: older Windows can run Go but lacks ConPTY.
+func PTYAvailable() bool {
+	dll := windows.NewLazySystemDLL("kernel32.dll")
+	return conPTYAvailable(func(name string) error { return dll.NewProc(name).Find() })
+}
+func conPTYAvailable(find func(string) error) bool {
+	for _, name := range []string{"CreatePseudoConsole", "ResizePseudoConsole", "ClosePseudoConsole"} {
+		if find(name) != nil {
+			return false
+		}
+	}
+	return true
+}
